# Copy to .env at the repo root. `make up` passes it to Compose when it exists.
# Every value here is a non-secret default; .env itself is gitignored.

# --- Cache nodes ---------------------------------------------------------------
# lru | lfu | s3fifo | lrb   (lrb is the learned policy)
CACHE_POLICY=lrb
# Rounded up to a power of two by the store.
CACHE_SHARDS=32
# Accepts b/kb/mb/gb/tb and kib/mib/gib/tib suffixes.
CACHE_CAPACITY=64MiB
# Candidates drawn per eviction. Larger is a better victim and a slower evict.
CACHE_SAMPLE_SIZE=8
# Expires entries stored without an explicit TTL, including everything fetched from
# origin. 0 means entries leave only by eviction or Delete, which is what the policy
# measurements assume: a TTL makes "gap to Belady MIN" meaningless.
CACHE_DEFAULT_TTL=0
# Prediction horizon. Must sit inside the workload's reuse times; see `make -C trainer boundary`.
MODEL_BOUNDARY=10m

# --- Trace sampling -----------------------------------------------------------
TRACE_ENABLED=true
# One key in N is recorded, by key hash, so sampled histories stay complete.
TRACE_SAMPLE_DENOMINATOR=16
TRACE_RING_CAPACITY=8192
# A segment is only trainable once it rotates: on size, on age, or on clean shutdown.
TRACE_SEGMENT_BYTES=8MiB
TRACE_SEGMENT_MAX_AGE=30s
TRACE_FLUSH_INTERVAL=1s
TRACE_BATCH_SIZE=4096

# --- Gateway ------------------------------------------------------------------
RING_REPLICAS=256
# Bounded-load ceiling: a node may hold at most this multiple of the mean load.
RING_LOAD_FACTOR=1.25
MAX_INFLIGHT=4096

# --- Gateway HTTP API ---------------------------------------------------------
# Off unless HTTP_ADDR is set. GET/PUT/DELETE /v1/keys/{key} and GET /v1/stats, so
# the cache is usable without generating gRPC stubs. `make up-min` turns it on.
HTTP_ADDR=
# Required whenever HTTP_ADDR is set: the gateway refuses to start otherwise, because
# an open HTTP port in front of a cache is a data leak. Generate one per environment
# and keep it out of git:
#   export HTTP_AUTH_TOKEN=$(openssl rand -hex 32)
HTTP_AUTH_TOKEN=
# Upstream deadline per HTTP request.
HTTP_TIMEOUT=5s

# --- Origin fixture -----------------------------------------------------------
ORIGIN_LATENCY=2ms
ORIGIN_JITTER=1ms
ORIGIN_MIN_SIZE=512
ORIGIN_MAX_SIZE=65536
ORIGIN_SIZE_ALPHA=1.5

# --- Load generator (host side, read by `make bench`) -------------------------
TARGET_ADDR=localhost:8080
REQUESTS=200000
KEYSPACE=100000
CONCURRENCY=64
WARMUP=20000
ZIPF_S=1.1
SEED=1
# Perf gate. Unset or zero means report only; set either and loadgen exits non-zero
# when the run misses it. CI sets both.
MIN_OBJECT_HIT=0
MAX_P99=0

# --- Logging ------------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info
# json | text
LOG_FORMAT=json

# --- Published ports ----------------------------------------------------------
GATEWAY_PORT=8080
GATEWAY_HTTP_PORT=8090
GATEWAY_DEBUG_PORT=9090
REGISTRY_PORT=8082
REGISTRY_DEBUG_PORT=9102
ORIGIN_DEBUG_PORT=9101
CACHENODE_0_DEBUG_PORT=9201
CACHENODE_1_DEBUG_PORT=9202
CACHENODE_2_DEBUG_PORT=9203
PROMETHEUS_PORT=9091
GRAFANA_PORT=3000

# --- Grafana ------------------------------------------------------------------
# Local-only credentials for an unauthenticated-by-design dev stack. Never reuse
# these anywhere reachable; production Grafana belongs behind real SSO.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
